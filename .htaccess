# ── Red Rooster Restaurant — .htaccess seguro ─────────────────────────────────

# Desactivar listado de directorios (nunca mostrar contenido de carpetas)
Options -Indexes

# ── Bloquear acceso directo a archivos sensibles ───────────────────────────────
<FilesMatch "^(config|security)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Bloquear acceso directo a los datos JSON
<FilesMatch "\.json$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Bloquear archivos de respaldo y temporales
<FilesMatch "\.(bak|backup|sql|log|tmp|swp|~)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Bloquear archivos ocultos (como .git)
<Files ~ "^\." >
    Order Allow,Deny
    Deny from all
</Files>

# ── Permisos de directorio data/ ───────────────────────────────────────────────
# (también crea un .htaccess dentro de data/ como segunda capa)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data/ - [F,L]
</IfModule>

# ── Headers de seguridad HTTP ──────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self';"

    # Caché de fuentes e imágenes (assets estáticos)
    <FilesMatch "\.(ttf|otf|woff|woff2)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpg|jpeg|gif|ico|svg)$">
        Header set Cache-Control "max-age=604800, public"
    </FilesMatch>

    # Sin caché para HTML y PHP (siempre fresco)
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ── Compresión GZIP ────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ── Forzar HTTPS (descomenta cuando el SSL esté activo en Hostinger) ───────────
